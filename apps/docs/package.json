{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "bun run sync:changelog && blume dev",
    "build": "bun run sync:changelog && blume build",
    "preview": "blume preview",
    "doctor": "blume doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:changelog": "mkdir -p docs/_generated && sed 1,2d ../../packages/vue-pptx-document/CHANGELOG.md > docs/_generated/changelog.md"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.1",
    "blume": "^2.2.4",
    "vue": "^3.5.0",
    "vue-pptx-document": "workspace:*"
  }
}
