{
  "name": "vue-pptx-document-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.19",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --filter example dev",
    "dev:docs": "bun run --filter docs dev",
    "build": "bun run build:lib && bun run --filter example build",
    "build:docs": "bun run build:lib && bun run --filter docs build",
    "build:lib": "bun run --filter vue-pptx-document build",
    "lint:package": "bun run --filter vue-pptx-document lint:package",
    "test": "bun run --filter vue-pptx-document test",
    "test:coverage": "bun run --filter vue-pptx-document test:coverage",
    "test:browser": "bun run --filter vue-pptx-document test:browser",
    "test:e2e": "bun run build && bun run --filter example test:e2e",
    "test:pack": "bun run --filter vue-pptx-document test:pack",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/samples.js --check && bun run format:check && bun run lint && bun run typecheck && bun run test:coverage",
    "sync:samples": "node scripts/samples.js"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10",
    "globals": "^17.13.0",
    "prettier": "^3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vue-eslint-parser": "^10"
  }
}
